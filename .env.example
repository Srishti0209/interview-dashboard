# Client (safe to expose; data is protected by row-level security)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable key>

# Server only (Vercel env vars / local scripts) — never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=
CLAUDE_API_KEY=
