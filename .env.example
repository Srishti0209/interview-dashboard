# AI_FIXTURE=0
# Optional: per-user daily caps and per-task models (defaults in api/_lib).
# AI_DAILY_LIMITS=resume=3,read=5,chat=150,write=10,critique=20,jd=5   (or "off")
# AI_MODEL_WRITE=claude-sonnet-5-5


